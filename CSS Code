:root {
    --bg: #070b24;
    --panel: #0d1433;
    --text: #f8f4ff;
    --muted: #c4c8e7;
    --purple: #c875ff;
    --blue: #46c9ff;
    --border: #353b78;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    overflow-x: hidden;
    line-height: 1.6;
    transition: background 0.35s, color 0.35s;
}

a {
    color: inherit;
    text-decoration: none;
}

button {
    font: inherit;
}

button:focus-visible,
a:focus-visible {
    outline: 2px solid var(--blue);
    outline-offset: 4px;
}

.navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    padding: 12px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    background: rgba(7, 11, 36, 0.88);
    border-bottom: 1px solid transparent;
    backdrop-filter: blur(16px);
    transition: 0.3s;
}

.navbar.scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 5px 25px #0005;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--purple);
}

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    color: var(--muted);
    font-size: 13px;
    transition: color 0.25s;
}

.nav-links a:hover,
.nav-links a.active {
    color: var(--purple);
}

.theme-toggle,
.menu-toggle {
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text);
    background: var(--panel);
    cursor: pointer;
    font-size: 20px;
}

.menu-toggle {
    display: none;
}

/* HERO */

.hero {
    min-height: 610px;
    padding: 120px 7% 65px;
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: 30px;
    overflow: hidden;
    background:
        radial-gradient(ellipse at 85% 40%, #542b8a55, transparent 45%),
        linear-gradient(110deg, #070b24 45%, #15123a 100%);
}

.hero-content {
    position: relative;
    z-index: 2;
}

.tag {
    display: inline-block;
    padding: 5px 13px;
    border-radius: 25px;
    background: linear-gradient(100deg, #4331a7, #252b76);
    border: 1px solid #8673ff44;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
}

.hero h1 {
    margin: 20px 0 5px;
    font-size: clamp(43px, 5.5vw, 76px);
    line-height: 1.1;
    letter-spacing: -3px;
}

.hero h1 span {
    background: linear-gradient(90deg, #f5a7ff, #8eacff, #46d9ff);
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
}

.hero h2 {
    font-size: clamp(18px, 2vw, 25px);
    font-weight: 500;
    color: #d9e1ff;
    margin-bottom: 15px;
}

.hero-content > p:not(.hand-note) {
    max-width: 440px;
    color: var(--muted);
    font-size: 14px;
}

.hero-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 13px;
    margin-top: 25px;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px 19px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    transition: transform 0.25s, box-shadow 0.25s;
}

.btn:hover {
    transform: translateY(-3px);
}

.btn.primary {
    color: white;
    background: linear-gradient(100deg, #e14cf1, #398bff, #26d5ed);
    box-shadow: 0 5px 25px #8a51ff40;
}

.btn.secondary {
    color: var(--text);
    border: 1px solid var(--purple);
    background: #11133288;
}

.hand-note {
    color: #d99aff;
    font-size: 12px;
    margin-top: 24px;
    font-style: italic;
}

/* DESK ILLUSTRATION */

.hero-art {
    min-height: 380px;
    position: relative;
    overflow: hidden;
    border-radius: 22px;
    background:
        linear-gradient(180deg, transparent 50%, #ff9c4e33),
        linear-gradient(135deg, #101632, #25204d 55%, #ef956a);
    box-shadow: inset 0 0 55px #080b2466;
}

.window-light {
    position: absolute;
    top: 0;
    right: 0;
    width: 72%;
    height: 65%;
    background:
        radial-gradient(ellipse at 45% 90%, #ffbb8a, transparent 18%),
        linear-gradient(180deg, #5634a3, #f86da7 52%, #ffbd83);
    border-left: 5px solid #11152d;
    border-bottom: 8px solid #17152f;
    box-shadow: inset 0 0 25px #17102c55;
}

.window-light::before {
    content: "";
    position: absolute;
    left: 47%;
    width: 5px;
    height: 100%;
    background: #17152f;
}

.window-light::after {
    content: "";
    position: absolute;
    top: 55%;
    width: 100%;
    height: 5px;
    background: #17152f;
}

.moon {
    position: absolute;
    top: 15%;
    right: 22%;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #ffdfbd;
    box-shadow: 0 0 35px #ffb5ce;
}

.plant {
    position: absolute;
    top: 16%;
    right: 4%;
    font-size: 65px;
    filter: drop-shadow(0 5px 8px #0005);
}

.laptop {
    position: absolute;
    z-index: 2;
    left: 9%;
    bottom: 18%;
    width: 58%;
    transform: rotate(-5deg);
    filter: drop-shadow(0 15px 12px #0008);
}

.laptop-screen {
    min-height: 170px;
    padding: 32px 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border: 5px solid #191b36;
    border-radius: 10px 10px 3px 3px;
    background: linear-gradient(135deg, #080d2d, #201c50);
    color: #e5c7ff;
    font-size: 17px;
    font-style: italic;
    box-shadow: inset 0 0 20px #6844a733;
}

.laptop-base {
    height: 13px;
    margin: 0 -12px;
    border-radius: 2px 2px 12px 12px;
    background: linear-gradient(#adb0d4, #343858 65%, #171b32);
}

.coffee {
    position: absolute;
    z-index: 3;
    right: 25%;
    bottom: 27%;
    width: 57px;
    height: 57px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 5px 5px 17px 17px;
    background: linear-gradient(140deg, #f7d5c7, #b7b9f8);
    color: #9d4dd5;
    font-size: 25px;
    box-shadow: 0 8px 12px #0004;
}

.coffee small {
    font-size: 8px;
}

.books {
    position: absolute;
    z-index: 2;
    top: 28%;
    right: 3%;
    width: 32%;
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.books span {
    padding: 7px 10px;
    border: 1px solid #b8a3ff55;
    border-radius: 3px;
    background: linear-gradient(90deg, #191638, #40316a);
    color: #efc7ff;
    font-size: 11px;
    font-style: italic;
    box-shadow: 0 5px 8px #0004;
}

.sticky-note {
    position: absolute;
    z-index: 4;
    right: 5%;
    bottom: 8%;
    padding: 13px;
    background: #f7d8d8;
    color: #43345b;
    font-size: 10px;
    line-height: 2;
    transform: rotate(-5deg);
    box-shadow: 0 5px 12px #0004;
}

.art-star {
    position: absolute;
    z-index: 5;
    color: #e8a9ff;
    font-size: 28px;
    animation: twinkle 2.5s infinite alternate;
}

.star-one {
    top: 14%;
    left: 10%;
}

.star-two {
    bottom: 12%;
    left: 7%;
}

.star-three {
    top: 42%;
    left: 51%;
}

.scroll-note {
    position: absolute;
    bottom: 20px;
    left: 7%;
    color: #a6b2e7;
    font-size: 9px;
    letter-spacing: 2px;
}

/* ABOUT */

.section {
    padding: 55px 5%;
}

.about {
    display: grid;
    grid-template-columns: 0.8fr 1.25fr 2fr;
    align-items: center;
    gap: 28px;
    margin: 0 4%;
    border: 1px solid var(--border);
    border-radius: 22px;
    background:
        radial-gradient(circle at 10% 20%, #38247755, transparent 30%),
        linear-gradient(135deg, #0a1030, #0d1433);
}

.profile-art {
    min-height: 180px;
    position: relative;
    display: grid;
    place-items: center;
}

.profile-circle {
    width: 160px;
    height: 160px;
    display: grid;
    place-items: center;
    border-radius: 48% 52% 42% 58%;
    background:
        radial-gradient(circle at 60% 35%, #ffb6cc, transparent 25%),
        linear-gradient(145deg, #a76bff, #4b62b6 55%, #ff9ebd);
    border: 2px solid #b57aff;
    box-shadow: 0 0 35px #8c48ff33;
    transform: rotate(-7deg);
}

.profile-circle span {
    font-size: 42px;
    font-weight: 800;
    letter-spacing: -3px;
    text-shadow: 0 3px 15px #28134b;
}

.profile-heart,
.profile-star {
    position: absolute;
    color: #dc9dff;
    font-size: 27px;
}

.profile-heart {
    bottom: 20px;
    left: 5%;
}

.profile-star {
    top: 10px;
    right: 10%;
}

.about-copy h2 {
    font-size: 25px;
    margin: 8px 0;
}

.about-copy h2 span {
    color: #9dbeff;
}

.about-copy p {
    color: var(--muted);
    font-size: 12px;
    margin: 8px 0;
}

.about-copy .signature {
    color: #d7a5ff;
    font-style: italic;
}

.qualities {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
}

.quality {
    text-align: center;
    padding: 10px 12px;
    border-right: 1px solid var(--border);
}

.quality:last-child {
    border-right: 0;
}

.quality-icon {
    width: 60px;
    height: 60px;
    display: grid;
    place-items: center;
    margin: 0 auto 12px;
    border-radius: 17px;
    font-size: 31px;
    background: #27205a;
    box-shadow: 0 0 25px #784bff22;
}

.quality-icon.purple { color: #d7a4ff; }
.quality-icon.blue { color: #4de0ff; background: #122d50; }
.quality-icon.violet { color: #b5c4ff; background: #25265f; }
.quality-icon.pink { color: #ff9de0; background: #4a2058; }

.quality h3 {
    font-size: 12px;
    margin-bottom: 7px;
}

.quality p {
    color: var(--muted);
    font-size: 10px;
}

/* SKILLS */

.skills-section {
    padding: 25px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 35px;
    flex-wrap: wrap;
    background: linear-gradient(100deg, #b6c8ff, #dbe7ff 55%, #f2c9f6);
    color: #111c4a;
}

.skills-heading {
    flex: 1 1 240px;
}

.skills-heading .tag {
    color: #fff;
    background: #478de7;
}

.skills-heading h2 {
    font-size: 27px;
    line-height: 1.3;
    margin: 8px 0;
}

.skills-heading h2 span {
    color: #468bff;
}

.skills-heading p {
    max-width: 300px;
    font-size: 12px;
}

.skills-list {
    flex: 2 1 550px;
    display: grid;
    grid-template-columns: repeat(7, minmax(55px, 1fr));
    gap: 15px;
}

.skill {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 8px;
    text-align: center;
    font-size: 11px;
}

.skill-icon {
    width: 57px;
    height: 57px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 5px 20px #4c5eaa20;
    font-weight: 900;
    font-size: 20px;
    transition: transform 0.25s;
}

.skill:hover .skill-icon {
    transform: translateY(-5px) rotate(-5deg);
}

.html { color: #ed633a; }
.css { color: #3179e8; }
.js { color: #aa8300; background: #ffec77; }
.python { color: #377ab7; }
.cpp { color: #355bc4; }
.mysql { color: #24749b; }
.more { color: #d34ed7; }

/* PROJECTS */

.projects {
    padding: 55px 8%;
}

.projects-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 25px;
}

.projects-heading h2 {
    font-size: 29px;
    margin: 7px 0;
}

.projects-heading h2 span {
    color: var(--purple);
}

.projects-heading p {
    color: var(--muted);
    font-size: 12px;
}

.project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
}

.project-card {
    min-width: 0;
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 14px;
    padding: 12px;
    border: 1px solid #292f60;
    border-radius: 16px;
    background: linear-gradient(135deg, #0d1433, #111a40);
    transition: transform 0.3s, border-color 0.3s;
}

.project-card:hover {
    transform: translateY(-5px);
    border-color: var(--purple);
}

.project-preview {
    min-height: 115px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 9px;
    overflow: hidden;
}

.weather-preview {
    flex-direction: column;
    background: linear-gradient(145deg, #a8e7ff, #7b8cf6 60%, #f0b7e9);
    color: #fff;
}

.weather-sun {
    font-size: 28px;
}

.weather-preview h3 {
    font-size: 24px;
}

.weather-preview p,
.weather-lines {
    font-size: 10px;
}

.game-preview {
    background: radial-gradient(circle, #29215f, #0b1031);
}

.tic-board {
    width: 95px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
}

.tic-board span {
    display: grid;
    place-items: center;
    width: 29px;
    height: 29px;
    border: 1px solid #7356cc;
    color: #63e9ff;
    font-weight: bold;
    font-size: 18px;
}

.tic-board span:nth-child(even) {
    color: #ff8fe3;
}

.portfolio-preview {
    background: linear-gradient(145deg, #28206a, #131b46, #9c57bc);
}

.mini-window {
    width: 80%;
    min-height: 90px;
    padding: 10px;
    border: 1px solid #a18bff;
    border-radius: 7px;
    background: #0b1035dd;
    box-shadow: 0 0 25px #a34aff33;
}

.mini-window span {
    font-size: 10px;
    color: #d7b2ff;
}

.mini-window div {
    height: 5px;
    width: 80%;
    margin-top: 7px;
    border-radius: 5px;
    background: #6b70d4;
}

.mini-window div:nth-child(3) {
    width: 55%;
}

.mini-window div:nth-child(4) {
    width: 68%;
}

.project-info > span {
    font-size: 12px;
    font-weight: 700;
}

.project-info p {
    margin: 8px 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.6;
}

.project-link {
    color: #7ad7ff;
    font-size: 10px;
}

.project-link:hover {
    color: var(--purple);
}

/* CONTACT */

.contact {
    padding: 30px 7%;
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 0.7fr 0.7fr;
    align-items: center;
    gap: 22px;
    border-top: 1px solid #30316b;
    background:
        radial-gradient(ellipse at 90% 100%, #7433a555, transparent 45%),
        linear-gradient(100deg, #0a1436, #16194c);
}

.contact-title h2 {
    font-size: 25px;
    margin: 8px 0;
}

.contact-title > p {
    color: var(--muted);
    font-size: 11px;
}

.contact-item {
    display: flex;
    align-items: center;
    gap: 12px;
    overflow-wrap: anywhere;
}

.contact-item > span {
    color: var(--purple);
    font-size: 25px;
}

.contact-item small,
.socials small {
    color: #c4c9f1;
    font-size: 11px;
}

.contact-item p {
    color: var(--muted);
    font-size: 10px;
}

.socials > div {
    display: flex;
    gap: 8px;
    margin-top: 8px;
}

.socials a {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border-radius: 7px;
    color: white;
    background: #5442a0;
    font-size: 9px;
    font-weight: bold;
}

.socials a:hover {
    background: #a44df1;
}

.thanks {
    color: #e1a6ff;
    font-size: 17px;
    font-style: italic;
    text-align: center;
    transform: rotate(-6deg);
}

.back-top {
    position: fixed;
    right: 22px;
    bottom: 22px;
    z-index: 900;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #9d56ff, #30bdf7);
    color: white;
    font-size: 22px;
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: 0.3s;
}

.back-top.visible {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

@keyframes twinkle {
    from { opacity: 0.45; transform: scale(0.85); }
    to { opacity: 1; transform: scale(1.15); }
}

/* LIGHT THEME */

body.light-theme {
    --bg: #f2efff;
    --panel: #ffffff;
    --text: #191439;
    --muted: #625d7b;
    --border: #d5c9f4;
}

body.light-theme .navbar {
    background: #f3efffeF;
}

body.light-theme .hero {
    background: linear-gradient(120deg, #e8e4ff, #f5e6ff, #d7eeff);
}

body.light-theme .hero h2 {
    color: #41345f;
}

body.light-theme .hero-art {
    border: 1px solid #c5b5f5;
}

body.light-theme .about,
body.light-theme .project-card {
    background: linear-gradient(135deg, #fff, #f0ebff);
}

body.light-theme .project-card {
    border-color: #d9d0f6;
}

body.light-theme .btn.secondary {
    color: var(--text);
    background: #ffffff88;
}

body.light-theme .contact {
    background: linear-gradient(100deg, #e7e5ff, #f5e6ff);
    border-color: #d5c9f4;
}

body.light-theme .contact-item small,
body.light-theme .socials small {
    color: #554d76;
}

/* RESPONSIVE DESIGN */

@media (max-width: 1100px) {
    .about {
        grid-template-columns: 0.7fr 1.3fr;
    }

    .qualities {
        grid-column: 1 / -1;
    }

    .project-grid {
        grid-template-columns: 1fr;
    }

    .project-card {
        grid-template-columns: 140px 1fr;
    }

    .contact {
        grid-template-columns: repeat(3, 1fr);
    }
}

@media (max-width: 760px) {
    .navbar {
        padding: 12px 5%;
        gap: 12px;
    }

    .menu-toggle {
        display: block;
        margin-left: auto;
    }

    .nav-links {
        display: none;
        order: 5;
        flex-basis: 100%;
        flex-direction: column;
        align-items: stretch;
        gap: 0;
        padding: 10px;
        background: var(--panel);
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .nav-links.open {
        display: flex;
    }

    .nav-links a {
        display: block;
        padding: 10px;
    }

    .hero {
        grid-template-columns: 1fr;
        padding: 115px 6% 60px;
        text-align: center;
    }

    .hero-content > p:not(.hand-note) {
        margin: auto;
    }

    .hero-buttons {
        justify-content: center;
    }

    .hero-art {
        min-height: 330px;
        width: 100%;
    }

    .scroll-note {
        left: 6%;
    }

    .about {
        margin: 0 3%;
        padding: 30px 6%;
        grid-template-columns: 1fr;
        text-align: center;
    }

    .profile-art {
        min-height: 190px;
    }

    .qualities {
        grid-template-columns: repeat(2, 1fr);
        gap: 20px 0;
    }

    .quality:nth-child(2) {
        border-right: 0;
    }

    .skills-section {
        padding: 35px 6%;
    }

    .skills-list {
        grid-template-columns: repeat(4, 1fr);
    }

    .projects {
        padding: 45px 6%;
    }

    .projects-heading {
        align-items: flex-start;
        flex-direction: column;
    }

    .contact {
        grid-template-columns: repeat(2, 1fr);
        padding: 35px 6%;
    }

    .contact-title {
        grid-column: 1 / -1;
    }

    .thanks {
        text-align: left;
    }
}

@media (max-width: 420px) {
    .logo {
        font-size: 21px;
    }

    .hero h1 {
        font-size: 43px;
    }

    .hero-art {
        min-height: 280px;
    }

    .laptop-screen {
        min-height: 125px;
        font-size: 13px;
    }

    .plant {
        font-size: 43px;
    }

    .books span {
        padding: 5px;
        font-size: 9px;
    }

    .sticky-note {
        padding: 8px;
        font-size: 8px;
    }

    .qualities {
        grid-template-columns: repeat(2, 1fr);
    }

    .skills-list {
        grid-template-columns: repeat(3, 1fr);
    }

    .project-card {
        grid-template-columns: 1fr;
    }

    .project-preview {
        min-height: 150px;
    }

    .contact {
        grid-template-columns: 1fr;
    }

    .contact-title {
        grid-column: auto;
    }
}

@media (prefers-reduced-motion: reduce) {
    *, *::before, *::after {
        animation: none !important;
        scroll-behavior: auto !important;
        transition: none !important;
    }
}
